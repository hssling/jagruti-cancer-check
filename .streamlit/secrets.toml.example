# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets instead.

# Option 1: OpenRouter (used first if present)
OPENROUTER_API_KEY = "sk-or-..."
# OPENROUTER_MODEL = "anthropic/claude-opus-5.5"   # optional; e.g. anthropic/claude-haiku-5.5 for lower cost

# Option 2: Anthropic API directly
# ANTHROPIC_API_KEY = "sk-ant-..."
