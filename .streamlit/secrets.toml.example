# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets instead.

# Option 1: OpenRouter (used first if present). Free models by default.
OPENROUTER_API_KEY = "sk-or-..."
# OPENROUTER_MODEL = "anthropic/claude-haiku-5.5"   # optional: one paid model instead of the free ones

# Option 2: Anthropic API directly
# ANTHROPIC_API_KEY = "sk-ant-..."
